{
  "version": 2,
  "git": { "deploymentEnabled": true },
  "builds": [
    { "src": "api/index.js", "use": "@vercel/node" },
    { "src": "api/account.js", "use": "@vercel/node" },
    { "src": "api/accounts.js", "use": "@vercel/node" },
    { "src": "docs/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/account", "dest": "/api/account.js" },
    { "src": "/api/accounts", "dest": "/api/accounts.js" },
    { "src": "/api/(.*)", "dest": "/api/index.js" },
    { "src": "/", "dest": "/docs/index.html" },
    { "src": "/(.*)", "dest": "/docs/$1" }
  ],
  "trailingSlash": false
}
