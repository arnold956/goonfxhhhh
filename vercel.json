{
  "version": 2,
  "functions": {"api/index.js": {"runtime": "nodejs20.x"}},
  "rewrites": [
    {"source":"/api/:path*","destination":"/api/index.js"},
    {"source":"/health","destination":"/api/index.js"}
  ],
  "headers": [
    {"source":"/api/:path*","headers":[{"key":"Cache-Control","value":"no-store"}]}
  ]
}